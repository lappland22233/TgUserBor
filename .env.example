# =====================================================
# Telegram MTProto credentials (required)
# Get them at https://my.telegram.org/apps
# =====================================================
TG_API_ID=123456
TG_API_HASH=your_api_hash_here

# =====================================================
# Bot owner (Telegram numeric user id, required)
# This user has full permissions on every command.
# =====================================================
TG_OWNER_ID=0

# =====================================================
# Network Proxy (Optional, supports socks5 / mtproxy)
# Enable if your network cannot connect to Telegram directly
# =====================================================
# TG_PROXY_TYPE=socks5
# TG_PROXY_HOST=127.0.0.1
# TG_PROXY_PORT=7890
# TG_PROXY_USER=
# TG_PROXY_PASS=
# TG_PROXY_SECRET=

# =====================================================
# Logging
# =====================================================
LOG_LEVEL=info
LOG_DIR=./data/logs

# =====================================================
# Database
# =====================================================
DB_PATH=./data/db/bot.sqlite

# =====================================================
# Plugins
# =====================================================
PLUGIN_DIR=./plugins
PLUGIN_HOT_RELOAD=true

# =====================================================
# Command parser
# Comma separated list of accepted prefixes.
# =====================================================
COMMAND_PREFIXES=.,/

# =====================================================
# Session storage (MTProto StringSession)
# Will be auto-generated on first run.
# =====================================================
SESSION_PATH=./data/sessions/bot.session

# =====================================================
# Web GUI Dashboard 安全配置 (严格内网限制)
# =====================================================
GUI_PORT=3000
# 默认严格绑定 127.0.0.1 (仅本机访问)；如需允许局域网其他设备访问可设为 0.0.0.0 (公网IP依然会被防火墙自动拦截)
GUI_HOST=127.0.0.1
# 是否允许局域网私有网段 (192.168.x.x / 10.x.x.x / 172.16-31.x.x)；设为 false 则进一步收紧至仅允许 127.0.0.1 本机
GUI_ALLOW_LAN=false
# 仅在可信反向代理会覆盖 X-Forwarded-* 请求头时启用；代理应转发原始 Host、协议及客户端 IP。
GUI_TRUST_PROXY=false
